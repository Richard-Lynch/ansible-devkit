#
# ci — thin caller of the shared CI gate (ansible-devkit's reusable-ci.yml). The job id `ci` makes
# the required status check `ci / gate`; every repo built on ansible-devkit has this same file.
name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  ci:
    uses: Richard-Lynch/ansible-devkit/.github/workflows/reusable-ci.yml@{{ devkit_ref }}
    with:
      kind: collection
      # Every ansible-core this collection supports: meta/runtime.yml requires_ansible {{ requires_ansible }}.
      ansible_core: '{{ ansible_core | tojson }}'
